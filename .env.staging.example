# ==============================================================================
# GrowSkill AI / BuildYourSkill AI - Staging Environment Configuration Template
# ==============================================================================
ENVIRONMENT=staging
PROJECT_NAME="BuildYourSkill AI (Staging)"
VERSION="1.0.0-rc1"

# Database Configuration (Staging PostgreSQL instance)
DATABASE_URL=postgresql+psycopg://growskill_staging:staging_secret_pass@staging-db.internal:5432/growskill_staging?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30

# Security & Authentication
SECRET_KEY=REPLACE_WITH_STAGING_RANDOM_SECRET_KEY_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Strict mode enabled)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_STAGING_GEMINI_KEY
DEFAULT_LLM_MODEL=gemini-1.5-flash
STRICT_LLM_MODE=true
OPENAI_API_KEY=

# CORS Security
BACKEND_CORS_ORIGINS=["https://staging.buildyourskill.ai"]

# Rate Limiting & Beta
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MENTOR_PER_HOUR=50
RATE_LIMIT_PROJECTS_PER_HOUR=20
RATE_LIMIT_INTERVIEW_PER_HOUR=30
PRIVATE_BETA_MODE=true
BETA_ACCESS_CODE=STAGING-BETA-2026

# Sandbox Limits
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=256
