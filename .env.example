# Database (PostgreSQL with asyncpg / psycopg or local SQLite)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/growskill
# For local zero-setup dev fallback: sqlite+aiosqlite:///./growskill.db

# Authentication / JWT
SECRET_KEY=growskill-ai-super-secret-jwt-key-2026-secure-token
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI / LLM Provider (Google Gemini or OpenAI)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Optional OpenAI Fallback
OPENAI_API_KEY=

# GitHub Intelligence API Token (Optional, for higher rate limits)
GITHUB_TOKEN=

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:8000
