# ==============================================================================
# GrowSkill AI / BuildYourSkill AI - Development Environment Configuration Template
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="BuildYourSkill AI (Dev)"
VERSION="1.0.0-dev"

# Database Configuration (Local async SQLite or local PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./growskill.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security & Authentication
SECRET_KEY=growskill-dev-local-secret-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM Providers (Offline fallback allowed in dev)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash
STRICT_LLM_MODE=false
OPENAI_API_KEY=

# CORS Security
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Rate Limiting & Beta
RATE_LIMIT_ENABLED=false
PRIVATE_BETA_MODE=false
BETA_ACCESS_CODE=

# Sandbox Limits
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=256
