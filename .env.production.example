# ==============================================================================
# GrowSkill AI / BuildYourSkill AI - Production Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit actual passwords, private keys, or API tokens to git.

# Application Environment (development, staging, production)
ENVIRONMENT=production
PROJECT_NAME="BuildYourSkill AI"
VERSION="1.0.0"

# Database Configuration (Managed PostgreSQL 16+ with pgvector)
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL=postgresql+psycopg://growskill_admin:REPLACE_WITH_STRONG_DB_PASSWORD@prod-db.internal:5432/growskill_prod?sslmode=require
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30

# Security & Authentication
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_64_CHAR_CRYPTOGRAPHICALLY_SECURE_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Google Gemini or OpenAI)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_OFFICIAL_GEMINI_API_KEY
DEFAULT_LLM_MODEL=gemini-1.5-flash
STRICT_LLM_MODE=true
OPENAI_API_KEY=

# CORS Security (Strictly list your production frontend domains)
BACKEND_CORS_ORIGINS=["https://app.buildyourskill.ai","https://buildyourskill.ai"]

# Rate Limiting Controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MENTOR_PER_HOUR=30
RATE_LIMIT_PROJECTS_PER_HOUR=10
RATE_LIMIT_INTERVIEW_PER_HOUR=20

# Private Beta Access Gate
PRIVATE_BETA_MODE=true
BETA_ACCESS_CODE=BETA-AI-2026

# Code Execution Sandbox Hardening
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=256
